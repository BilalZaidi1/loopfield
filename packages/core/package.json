{
  "name": "@loopfield/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure TypeScript rules engine shared by the Expo app, Supabase edge functions and the job worker. No runtime dependencies.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
