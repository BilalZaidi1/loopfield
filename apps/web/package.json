    "@vercel/speed-insights": "^2.1.0",
    "lenis": "^1.3.27",
    "next": "16.4.6",
    "posthog-js": "^1.451.2",
    "postprocessing": "^6.39.6",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.6",
