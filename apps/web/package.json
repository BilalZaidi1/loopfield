{
  "name": "@loopfield/web",
  "version": "0.1.0",
  "private": true,
  "description": "Marketing site (Next.js on Vercel): one scroll-driven page with a 3D hex field, store buttons and the pages the stores require.",
  "type": "module",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "dev": "next dev --port 3200",
