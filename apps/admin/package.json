{
  "name": "@loopfield/admin",
  "version": "0.1.0",
  "private": true,
  "description": "Back office web console (Next.js on Vercel). Thin client over the database's ops_* API; staff sign in with Supabase Auth and TOTP.",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3100",
    "dev:fixtures": "CONSOLE_FIXTURES=1 next dev --port 3100",
