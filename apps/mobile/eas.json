{
  "cli": { "version": ">= 18.0.0", "appVersionSource": "remote" },
  "build": {
    "base": {
      "node": "22.11.0",
      "env": { "SENTRY_ORG": "futurama-labs", "SENTRY_PROJECT_MOBILE": "loopfield-mobile" }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": { "APP_ENV": "development" },
      "android": { "buildType": "apk" },
      "ios": { "simulator": false }
    },
    "development-simulator": {
      "extends": "development",
      "ios": { "simulator": true }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "environment": "preview",
      "env": { "APP_ENV": "preview" },
      "channel": "preview"
    },
    "production": {
      "extends": "base",
      "environment": "production",
      "env": { "APP_ENV": "production" },
      "channel": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
