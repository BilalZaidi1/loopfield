# Client-safe configuration only (bundled into the app). Never put secrets in EXPO_PUBLIC_* variables.
APP_ENV=development
APP_DISPLAY_NAME=
APP_BUNDLE_ID=dev.loopfield.app
APP_SCHEME=loopfield
EAS_PROJECT_ID=

# Supabase project URL and publishable (anon) key — both are public by design; RLS protects data.
EXPO_PUBLIC_SUPABASE_URL=https://xcykufhsjyhedkqginay.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Mapbox public token (pk.*) restricted to this app's bundle IDs in the Mapbox dashboard.
EXPO_PUBLIC_MAPBOX_TOKEN=
EXPO_PUBLIC_MAPBOX_STYLE_URL=mapbox://styles/mapbox/outdoors-v12
# PostHog project API key (phc_*) and host; product analytics only, autocapture and replay disabled in code.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Sentry DSN for the mobile project (DSNs are public identifiers).
EXPO_PUBLIC_SENTRY_DSN=
# RevenueCat public SDK keys (appl_* / goog_*). Server keys stay on the backend.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Competition selected by default before the runner picks one (the seeded dev public competition).
EXPO_PUBLIC_DEFAULT_COMPETITION_ID=00000000-0000-4000-8000-000000000031
# Optional "lng,lat" used to centre the map when location permission is not granted.
EXPO_PUBLIC_DEFAULT_MAP_CENTER=67.05,24.89
# Links shown at registration and in Help. Leave empty until the reviewed documents are published;
# the app then says plainly that the documents are not yet available.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=

# Build-time only (EAS secrets / CI, not EXPO_PUBLIC): SENTRY_AUTH_TOKEN for source-map upload.
# SENTRY_AUTH_TOKEN=
