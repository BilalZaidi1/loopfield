# Server-side environment for the edge functions (supabase/functions) and the job worker (services/worker).
# Copy to supabase/functions/.env (gitignored) and fill in. Upload with `scripts/setup-supabase.sh secrets`,
# which runs `supabase secrets set --env-file supabase/functions/.env`.
#
# Everything in this file is SERVER-ONLY. None of these values may appear in apps/mobile/.env or in any
# EXPO_PUBLIC_* variable, and none may be committed.
#
# Hosted edge functions receive SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, SUPABASE_ANON_KEY and SUPABASE_DB_URL
# from the platform, and `supabase secrets set` skips names that start with SUPABASE_. Fill the SUPABASE_* lines
# only for the worker container and for local runs.

# --- Supabase (required) ---------------------------------------------------------------------------
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Secret API key (sb_secret_…). The legacy service-role JWT is accepted as SUPABASE_SERVICE_ROLE_KEY instead.
SUPABASE_SECRET_KEY=
# Publishable key (sb_publishable_…) — used only to verify user sessions.
SUPABASE_PUBLISHABLE_KEY=
# Postgres connection string for the job handlers (use the session pooler for the worker).
SUPABASE_DB_URL=

# --- Competitive session tickets (required for territory or speed recording) ------------------------------
# Random 32+ byte secret used to sign session tickets; generate with: openssl rand -base64 48
TICKET_SIGNING_SECRET=

# --- Job runner (required when jobs run in the `jobs` edge function) -------------------------------------
# Shared secret pg_cron sends as x-jobs-secret. Store the same value in Vault with `scripts/setup-supabase.sh vault`.
JOBS_RUNNER_SECRET=

# --- Stream Chat (messaging) ---------------------------------------------------------------------------
# Server credentials from the Stream dashboard. The secret mints short-lived user tokens and verifies
# webhook signatures; only the API key (public) is given to the app.
STREAM_API_KEY=
STREAM_API_SECRET=

# --- RevenueCat (subscriptions; free pilot by default) ---------------------------------------------------
# The exact Authorization header value configured on the RevenueCat webhook.
REVENUECAT_WEBHOOK_AUTH=
# Secret REST API key (sk_…), used to reconcile entitlements after webhooks and purchases.
REVENUECAT_SECRET_API_KEY=
# Entitlement identifier configured in RevenueCat.
PREMIUM_ENTITLEMENT_ID=premium

# --- Resend (the only auth-email path) ---------------------------------------------------------------------
RESEND_API_KEY=
# Verified sender, e.g. "Loopfield <no-reply@auth.example.com>"; the domain must be verified in Resend.
RESEND_FROM=
# Signing secret (whsec_…) of the Resend webhook pointing at /functions/v1/resend-webhook.
RESEND_WEBHOOK_SECRET=
# Secret generated when creating the Send Email hook (Authentication > Hooks), format v1,whsec_…
SEND_EMAIL_HOOK_SECRET=

# --- Push notifications ---------------------------------------------------------------------------------
# Expo access token with push permission (enhanced push security). Optional; without it pushes are sent unauthenticated.
EXPO_ACCESS_TOKEN=

# --- Sentry (backend errors; scrubbed before sending) ------------------------------------------------------
SENTRY_DSN_BACKEND=
SENTRY_ENVIRONMENT=development

# --- App identity and links ------------------------------------------------------------------------------
APP_NAME=Loopfield
APP_SCHEME=loopfield
# Base for links in emails, e.g. loopfield:// or an HTTPS universal-link domain once one exists.
APP_LINK_BASE=loopfield://
# Release identifier attached to backend error reports.
RELEASE=dev

# --- Worker only (services/worker) ---------------------------------------------------------------------
# Comma-separated queues to serve (default: all).
WORKER_QUEUES=
WORKER_CONCURRENCY=2
WORKER_POLL_MS=1000
# Health endpoint port for container platforms.
PORT=8080
