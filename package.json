{
  "name": "loopfield",
  "private": true,
  "description": "Territory running app (working codename Loopfield) - Expo mobile app, Supabase backend, job worker and shared rules engine.",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:core": "npm run test -w @loopfield/core",
    "test:db": "bash scripts/test-db.sh",
    "test:worker": "npm run test -w @loopfield/worker",
    "worker": "npm run start -w @loopfield/worker",
    "verify": "bash scripts/verify.sh",
    "test:edge": "node scripts/smoke-functions.mjs",
    "test:cli-push": "bash scripts/test-cli-push.sh",
    "gen:types": "bash scripts/gen-types.sh",
    "check:queries": "node scripts/check-client-queries.mjs",
    "sync:core": "node scripts/sync-core.mjs",
    "setup:supabase": "bash scripts/setup-supabase.sh",
    "setup:stream": "tsx scripts/setup-stream.ts"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-test-renderer": "19.3.0"
  }
}
